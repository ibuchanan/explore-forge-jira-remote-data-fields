{
  "name": "jira-remote-data-fields-forge-app",
  "version": "0.0.0",
  "private": true,
  "description": "a Jira text-properties UI backed by a Forge Remote",
  "license": "Apache-2.0",
  "scripts": {
    "build": "bun build src/index.tsx --target browser --format esm --outdir resources",
    "check": "bun run build && bun run lint",
    "clean": "rm -rf dist",
    "forge:deploy": "bun run build && bash ../../scripts/env-var.sh 'forge deploy --environment \"$FORGE_ENVIRONMENT\"'",
    "forge:deploy:approve-system-user-change": "bun run build && bash ../../scripts/env-var.sh 'forge deploy --environment \"$FORGE_ENVIRONMENT\" --approve SYSTEM_USER_CHANGE_RULE'",
    "forge:install": "bash ../../scripts/env-var.sh 'forge install --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\" --non-interactive'",
    "forge:uninstall": "bash ../../scripts/env-var.sh 'forge uninstall --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\"'",
    "forge:upgrade": "bash ../../scripts/env-var.sh 'forge install --upgrade --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\" --non-interactive'",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "bun run lint:biome && bun run typecheck",
    "lint:biome": "biome check resources/index.html src",
    "lint:fix": "biome lint --write",
    "lint:forge": "bash ../../scripts/env-var.sh 'forge lint'",
    "lint:prelint": "bun run build",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@atlaskit/button": "^25.3",
    "@atlaskit/css-reset": "^8.4",
    "@atlaskit/primitives": "^22.5",
    "@atlaskit/section-message": "^10.2",
    "@atlaskit/select": "^18.4",
    "@atlaskit/textfield": "^10.2",
    "@forge/api": "^8.1",
    "@forge/bridge": "^7.0",
    "@forge/resolver": "^2.0",
    "react": "^18.3",
    "react-dom": "^18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3"
  }
}
